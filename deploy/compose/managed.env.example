# Managed edition — environment template.
# Copy to `.env` next to managed.yml (compose auto-loads it), then run
#   ./ensure-env-secrets.sh
# to generate every required secret that is still blank (idempotent — it never
# touches values you already set). The compose file has NO defaults for the
# required secrets on purpose (0020 T2).
# NEVER commit a filled-in copy — real secrets belong in a vault / the host only.

# ---- Postgres (ledger) ---------------------------------------------------
# POSTGRES_USER is the DB owner: used for migrations and the demo seed. In the
# postgres image the bootstrap user is a SUPERUSER and therefore bypasses RLS —
# the application must NOT use it for tenant data (see APP_DB_* below).
POSTGRES_USER=openmigrate
POSTGRES_PASSWORD=change-me-openmigrate
POSTGRES_DB=openmigrate
POSTGRES_PORT=5432

# ---- Application DB role (RLS enforcement) -------------------------------
# Non-owner role created by migration 0009. The API and worker connect through
# this role via APP_DATABASE_URL so row-level security is always enforced.
# Change the password from the migration default before any real deployment.
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password

# ---- Auth ----------------------------------------------------------------
# HS256 secret for local JWTs — REQUIRED, no default (0020 T2). With the
# tenant-membership gate this is the outer wall of the tenancy boundary; the
# API refuses to boot in production with a known placeholder value.
# Generate: openssl rand -hex 32
# The seed signs demo tokens with this exact value, so the API and the seed
# run MUST share it. (Managed SSO via JWKS uses JWT_ISSUER/JWT_AUDIENCE
# instead — leave JWT_SECRET unset in that mode.)
JWT_SECRET=
JWT_EXPIRY=24h

# Encrypts stored connection credentials (create-mapping + worker). 32 bytes:
# 64 hex chars or 44 base64 chars. Generate: openssl rand -hex 32
# The API and worker MUST share this value. Rotating it strands existing secrets.
SECRET_ENCRYPTION_KEY=

# ---- Microsoft 365 source credentials -------------------------------------
# The Entra app registration the Graph connectors authenticate with, and what
# 0028's drift detector needs to enumerate a tenant's mailboxes.
#
# Which flow you are in is decided by WHICH of these you set, not by a config
# flag — a flag can disagree with reality, credentials cannot:
#   CLIENT_ID + CLIENT_SECRET, no refresh token  → APPLICATION flow. Can read
#     shared mailboxes (/users/{address}) and enumerate the directory, once
#     admin consent and an Application Access Policy are in place. See
#     docs/o365-application-access.md.
#   CLIENT_ID + REFRESH_TOKEN                    → DELEGATED flow. Reads only
#     the signed-in mailbox (/me). Drift detection reports that it cannot look,
#     with the reason, rather than reporting "no new mailboxes".
#
# Leave blank for an IMAP-only stack. These are uploaded to the task
# environment by set-task-env.sh — task containers inherit nothing from
# compose, so a value only in this file is a value the jobs never see.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REFRESH_TOKEN=
OAUTH2_TENANT_ID=

# Does this deployment hold the `Files.Read.All` application permission?
# Only set this to `true` if it was actually granted — the flag does not grant
# anything, it decides whether the permission report ATTEMPTS to read OneDrive
# and SharePoint sharing. Left unset (the default), that section of the report
# says it was not inventoried and why, which is the honest answer and not the
# same as "nothing is shared".
#
# Declined for the reference deployment (owner decision 2026-08-04): the
# Application Access Policy that narrows every other scope here is an Exchange
# mechanism and cannot reach SharePoint, so `Files.Read.All` would mean read
# access to every file in the tenant. See docs/o365-application-access.md,
# "Two scopes, one granted".
GRAPH_FILES_READ_CONSENTED=

# ---- Notifications (workplan 0030) ---------------------------------------
# The operator's OWN SMTP relay, used for two things: the per-tenant "what
# needs attention" digest (managed-digest, daily at 08:00 UTC, cadence chosen
# per tenant on the Tenants screen) and the rollback notice when a rollback is
# submitted with notifyUsers: true.
#
# Leave these blank to run without email. Nothing breaks: the channel reports
# itself OFF with the reason in the task log, and the rollback job REFUSES
# notifyUsers: true up front rather than rolling back and telling nobody.
#
# Set them ALL or none. A half-set channel stays off and names what is missing,
# because somebody who set SMTP_HOST and stopped has plainly tried.
#
# These are uploaded to the task environment by set-task-env.sh — task
# containers inherit nothing from compose, so a value only in this file and
# never uploaded is a value the digest will never see. Re-run that script
# after changing any of them.
SMTP_HOST=
SMTP_PORT=              # default 587 (STARTTLS), or 465 when SMTP_SECURE=true
SMTP_SECURE=            # true = implicit TLS on connect
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=            # the From: address the digests are sent from
NOTIFY_TO=              # operator address(es) for ad hoc events, comma-separated
                        # (tenant digests go to that tenant's owners and admins)
NOTIFY_LOCALE=          # en | nl — the operator's language for ad hoc events

# ---- Prices (the template for NEW tenants) --------------------------------
# INTEGER CENTS, never euros. €9.99/month is 999. A value with a decimal point
# (or a negative one, or text) makes the API refuse to boot and name the
# variable — deliberately, because the alternative is billing every customer a
# hundredth of what you meant and finding out from the bank.
#
# THESE ARE A TEMPLATE, NOT THE PRICES IN FORCE. Each tenant's agreed prices
# are pinned in the `tenant_pricing` table the first time that tenant's money
# is computed, and never follow this file again. So changing a value here:
#   - changes what tenants signed up AFTER the change pay;
#   - changes NOTHING for tenants already being billed.
# That is the point. Re-pricing an existing customer is a conversation, not a
# config edit — and if you do mean to, the SQL for one tenant is in
# docs/operator-runbook.md, "Prices".
#
# Leave a line blank to keep the built-in default (shown in the comment).
# Restart the api and re-run set-task-env.sh after changing any of them —
# the worker meters against the same numbers.
PRICING_BASE_FEE_CENTS=          # default 999   (€9.99 / month)
PRICING_STORAGE_PER_GB_CENTS=    # default 10    (€0.10 / GB / month)
PRICING_EGRESS_PER_GB_CENTS=     # default 20    (€0.20 / GB)
PRICING_COMPUTE_PER_HOUR_CENTS=  # default 5     (€0.05 / compute hour)
# VAT is NOT here on purpose: a tax rate is set by a government and applies to
# everyone at once, so it is neither per tenant nor per deployment (21%, one
# constant in @openmig/shared).

# ---- Trigger.dev (self-host orchestration) -------------------------------
TRIGGER_PORT=3090
# The five trigger auth secrets — ALL REQUIRED, no compose defaults (0020 T2).
# They gate the trigger dashboard, its magic-link login, its encrypted env-var
# store and the supervisor's worker auth. Generate each: openssl rand -hex 16
TRIGGER_ENCRYPTION_KEY=
TRIGGER_LOGIN_SECRET=
TRIGGER_SESSION_SECRET=
TRIGGER_MAGIC_LINK_SECRET=
TRIGGER_MANAGED_WORKER_SECRET=
# The https front for the trigger dashboard (the trigger-tls service).
# Production-mode Secure cookies make the dashboard unusable over plain http
# from anything but localhost, so browsers go through trigger-tls (0020 T3).
# Set TRIGGER_TLS_HOST to the address browsers actually use (e.g. the
# machine's VPN IP) — it is both the certificate's subject and the SNI
# default for IP-connecting browsers.
TRIGGER_TLS_HOST=localhost
TRIGGER_TLS_PORT=3443
# Browser-facing origins: point APP/LOGIN at the https front. API_ORIGIN
# STAYS http://localhost:3090 — the deploy CLI follows the server-advertised
# API origin and must not hit a self-signed certificate (0018 T5: deploys
# died with a bare "Connection error" when it did).
TRIGGER_APP_ORIGIN=https://localhost:3443
TRIGGER_LOGIN_ORIGIN=https://localhost:3443
TRIGGER_API_ORIGIN=http://localhost:3090
# ONE image tag for webapp AND supervisor, matching @trigger.dev/sdk in
# apps/worker/package.json exactly — check both when bumping either (0018 T0).
# bootstrap-managed.sh's `trigger` phase now refuses when they disagree.
#
# PINNED AT 4.5.9 ON EVIDENCE, NOT INERTIA. The repository drifted to SDK
# 4.5.11 against v4.5.9 images, and reconciling upward broke the reference
# deployment within an hour: the supervisor looped on
#
#   Failed to start run … "Snapshot changed inside startRunAttempt"
#
# for every run, no task body executed, and the queue backed up at one run a
# minute. v4.5.9 has ~27,500 successful runs behind it on that box; 4.5.11 has
# an outage. Bumping is a deliberate exercise with the queue drained first —
# see docs/managed-bring-up.md, "Upgrading Trigger.dev".
TRIGGER_IMAGE_TAG=v4.5.9
# The api enqueues with the PROD environment secret key (tr_prod_…), minted by
# the instance's own dashboard AFTER first bring-up — so it starts empty, and
# every enqueue fails loudly by name until it is set (then restart the api).
# Flow: deploy/compose/deploy-tasks.sh's header, steps 2–3.
TRIGGER_SECRET_KEY=
# The proj_… ref from the dashboard's project settings; used by the deploy.
TRIGGER_PROJECT_REF=
# WHICH environment the tasks deploy into, and which one TRIGGER_SECRET_KEY
# above belongs to — they must be the SAME one. `trigger.dev deploy` defaults
# to prod, which is why this stayed implicit for so long; one instance can
# serve a test stack and a production stack side by side, so it is now explicit.
# Point them at different environments and NOTHING errors: the deploy succeeds,
# the enqueue succeeds, and the runs never meet a deployed task. deploy-tasks.sh
# refuses the two combinations that are unambiguously that mistake.
TRIGGER_ENV=prod
# Host port for the task-image registry (loopback-bound; see managed.yml).
REGISTRY_PORT=5000
# ClickHouse (task-event store the trigger dashboard queries — see managed.yml).
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse
# MinIO (trigger object store — packet/large-payload storage; internal-only,
# but change the password anyway: trigger-api reads the same pair).
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio
# Architecture task images are BUILT FOR (a server-side deploy decision the
# CLI obeys). MUST match the host running the supervisor's containers, or
# every task run dies at exec: uname -m x86_64 → linux/amd64, aarch64 →
# linux/arm64.
DEPLOY_IMAGE_PLATFORM=linux/amd64

# ---- Billing (Mollie test mode — T5, optional) ---------------------------
# Leave blank until billing is wired end-to-end. Use test-mode keys only.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# ---- Demo backend (T7 DoD demo only — see deploy/compose/setup-managed-demo.sh) ----
# Nextcloud gives the demo tenants a real CalDAV/CardDAV/WebDAV backend. Not needed
# for a real deployment (tenants configure their own connections via the API).
NEXTCLOUD_PORT=8083
NEXTCLOUD_ADMIN_PASSWORD=change-me-nextcloud-admin

# ---- Backups (workplan 0085 T5) -------------------------------------------
# How many days a backup of this deployment's Postgres is kept before it ages
# out. It is NOT a backup schedule — nothing here takes backups; it is what we
# TELL A CUSTOMER when they ask us to erase their data.
#
# Erasure does not finish when the rows are deleted: every backup taken before
# the purge still contains them. So the promise is made in two parts — removed
# from the live service on the day the customer's window runs out, and gone
# from backups a further BACKUP_RETENTION_DAYS after that. Get this number
# wrong and the date on that promise is wrong.
#
# The reference deployment is 7 (owner, 2026-08-18). Leave blank for that.
# Set it to 0 ONLY if this deployment genuinely takes no backups — the wording
# then says so plainly rather than quoting the same date twice.
BACKUP_RETENTION_DAYS=

# ---- Worker timeouts (seconds) -------------------------------------------
IMAP_TIMEOUT=300
JMAP_TIMEOUT=300

# ---- Rotation ------------------------------------------------------------
# Treat every value in this file as compromised the moment it appears in a
# pasted log or screenshot — and note that trigger RUNNER debug logs print the
# full task environment (DATABASE_URL, SECRET_ENCRYPTION_KEY, the tr_prod_
# key), so runner logs are secret-bearing by construction. Rotation order:
# regenerate the value here, `docker compose up -d` the affected services,
# re-run deploy/compose/deploy-tasks.sh if task env vars changed, and re-mint
# any JWTs signed with a rotated JWT_SECRET. Rotating SECRET_ENCRYPTION_KEY
# strands stored connection credentials — re-enter those via the API.

# ---- Ports / URLs --------------------------------------------------------
API_PORT=3001
WEB_PORT=3123
# CORS_ORIGIN / WEB_URL: the address BROWSERS use for the web app. WEB_URL is
# where Mollie sends the customer back after payment — on a real deployment set
# both to the public https address, not localhost.
CORS_ORIGIN=http://localhost:3123
WEB_URL=http://localhost:3123
# API_URL: the address MOLLIE'S SERVERS use to deliver payment webhooks. A
# localhost value on a real deployment means payments complete but invoices
# never leave 'sent' — with MOLLIE_API_KEY set, the API refuses to boot in
# production on a localhost API_URL for exactly that reason.
API_URL=http://localhost:3001
# VITE_API_URL is baked into the web BUILD. The default /api keeps browser
# calls same-origin; the web image's nginx proxies them to the api service.
# Only set an absolute URL here for direct-to-API access — then CORS_ORIGIN
# must name the web origin, and you rebuild the web image to change it.
VITE_API_URL=/api
NODE_ENV=production

# --- Connection pooling (workplan 0082 T4) ---------------------------------
# PgBouncer runs in TRANSACTION mode in front of Postgres. The app and the
# worker connect through it; migrations always connect direct, because they
# hold a session-scoped advisory lock across many transactions.
#
# ROLLBACK: set these two to postgres / 5432 and `compose up -d`. Every service
# reads them, so that single change puts the whole stack back on direct
# connections without editing managed.yml.
DB_HOST=pgbouncer
DB_PORT=6432
# Generated by ensure-env-secrets.sh, which also writes pgbouncer/userlist.txt.
# The matching Postgres role is created by pgbouncer/setup-auth.sql — run it
# once against DIRECT_DATABASE_URL before starting pgbouncer.
PGBOUNCER_AUTH_PASSWORD=

# ---- Identity provider (ADR-0042) ----------------------------------------
# Run ./deploy/compose/setup-zitadel.sh: it generates the secrets, starts the
# provider, provisions the project and the browser client, and writes every
# value below. None of it is meant to be filled in by hand.
#
# CHANGING PROVIDER IS CHANGING JWT_ISSUER AND JWT_AUDIENCE. The API discovers
# where the keys are from the issuer's own /.well-known/openid-configuration
# and knows no provider's URL shape (ADR-0042; enforced by
# apps/api/src/middleware/no-issuer-lock-in.unit.test.ts).
#
# Setting JWT_ISSUER makes the API stop using JWT_SECRET — `selectAuthMode`
# prefers JWKS on purpose, so a leftover shared secret cannot silently
# downgrade verification.
JWT_ISSUER=
JWT_AUDIENCE=
# Only for a provider that publishes no discovery document. It pins a URL that
# key rotation can move underneath you; leave it empty.
JWT_JWKS_URI=

# The browser-visible address of the provider. It is baked into every token's
# `iss` claim, so changing it after tokens exist invalidates them — the fourth
# variable carrying a browser-visible address (workplan 0091 T1).
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
ZITADEL_PORT=8080
# `disabled` terminates TLS elsewhere (netbird, in this deployment); `external`
# tells the provider that something in front of it already did.
ZITADEL_TLS_MODE=disabled

# Generated by ensure-env-secrets.sh. MASTERKEY encrypts the provider's own
# data: filling in a blank one is safe, replacing a live one strands every
# account, which is why that script refuses to rotate it.
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_USERNAME=owner
ZITADEL_ADMIN_PASSWORD=
# The provisioning token's expiry, set one day out by setup-zitadel.sh. It
# exists to provision and then to become useless.
ZITADEL_PAT_EXPIRY=
# ---------------------------------------------------------------- status page --
# The port the status page listens on (workplan 0094). It reads WEB_URL above to
# decide what to probe — the address a BROWSER uses, because probing an internal
# service name would prove the container can talk to itself and nothing about
# the path a customer takes.
#
# The page runs inside this stack, so it cannot tell you the stack is down; see
# docs/status-page.md for what it can and cannot answer.
STATUS_PORT=3124


# Baked into the web bundle at BUILD time, like VITE_API_URL — change either
# and the web image must be rebuilt, not just restarted.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
